# ─────────────────────────────────────────────────────────────
# CommentGuard environment. Copy to .env (local) and add the same
# keys in Vercel → Project → Settings → Environment Variables.
# Never commit .env.
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
# Supabase: Project → Connect → "Transaction pooler" (port 6543).
# Local:    postgres://postgres:postgres@localhost:5432/commentguard
DATABASE_URL=

# ── Admin login (only you) ──────────────────────────────────
ADMIN_EMAIL=you@example.com
# Generate with:  npm run hash-password -- 'a long password you will remember'
ADMIN_PASSWORD_HASH=

# ── Secrets: generate all three with  npm run gen-key ───────
# Encrypts the Instagram token in the database (32 bytes, base64).
TOKEN_ENCRYPTION_KEY=
# Signs the login cookie (at least 32 characters).
SESSION_SECRET=
# The cron caller must send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Instagram ───────────────────────────────────────────────
# Long-lived token from the Meta dashboard (see README → Meta setup, step 6).
# Optional: you can paste it in Settings → Instagram instead. After the first
# connect it is stored encrypted and refreshed automatically; you can then
# delete it from here.
IG_ACCESS_TOKEN=
# Graph API version used for graph.instagram.com calls.
IG_API_VERSION=v25.0
# true = fake Instagram data (try the panel before Meta setup; token "mock-token").
IG_MOCK=false

# Timezone for the panel (and the Auto/Manual schedule in Step 4).
APP_TIMEZONE=Asia/Kolkata
