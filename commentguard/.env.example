# ─────────────────────────────────────────────────────────────
# CommentGuard environment. Copy to .env (local) and add the same
# keys in Vercel → Project → Settings → Environment Variables.
# Never commit .env.
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
# Supabase: Project → Connect → "Transaction pooler" (port 6543).
# Local:    postgres://postgres:postgres@localhost:5432/commentguard
DATABASE_URL=

# ── Admin login (only you) ──────────────────────────────────
ADMIN_EMAIL=you@example.com
# Either a plain password (12+ characters)...
ADMIN_PASSWORD=
# ...or, better, a hash from:  npm run hash-password -- 'your password'
# (if both are set, the hash is used)
ADMIN_PASSWORD_HASH=

# ── Secrets: random text, 32+ characters each ───────────────
# (a password generator works, or run  npm run gen-key)
# Encrypts the Instagram token in the database. Never change it once set.
TOKEN_ENCRYPTION_KEY=
# Signs the login cookie (at least 32 characters).
SESSION_SECRET=
# The cron caller must send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Meta app (developers.facebook.com → your app) ──────────
# App settings → Basic → App ID / App secret.
META_APP_ID=
META_APP_SECRET=
# Use cases → Instagram → "API setup with Unified login" → your configuration's ID.
META_CONFIG_ID=
# Public address of this app, no trailing slash. The redirect URL to register in
# Meta is APP_URL + /api/auth/meta/callback. (Defaults to the address you open.)
APP_URL=https://your-app.vercel.app

# ── Instagram ───────────────────────────────────────────────
# Optional. Normally you click "Connect with Meta" in Settings instead.
# A token pasted here is used once on first run, then stored encrypted.
IG_ACCESS_TOKEN=
# Optional: the Instagram account ID to guard, if your login can see several.
IG_USER_ID=
# Graph API version.
IG_API_VERSION=v25.0
# true = fake Instagram data (try the panel before Meta setup).
IG_MOCK=false

# Timezone for the panel (and the Auto/Manual schedule in Step 4).
APP_TIMEZONE=Asia/Kolkata
